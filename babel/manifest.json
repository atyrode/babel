{
  "id": "atyrode.babel",
  "version": "0.4.0",
  "title": "babel",
  "description": "Babel on the hub: the doors the operator rules through and the store they read. One list of every record Babel produced, ranked by what needs him; rulings, asks, answers, interest and filings as append-only acts; topics as ledger entities; runs on enrolled machines as jobs. Its data is rows — records, links, votes, filings, entities, facts — in one SQLite file of its own.",
  "capabilities": [
    "containers:read",
    "containers:write",
    "machines:read",
    "machines:run",
    "jobs:read",
    "jobs:input",
    "jobs:cancel",
    "locations:read",
    "locations:write",
    "services:configure",
    "services:invoke"
  ],
  "dependencies": {
    "atyrode.code": {
      "type": "required",
      "reason": "a Babel run is a Code session: Code owns the profile (model, thinking level, account) and posts the omp job through its runSession door, which Babel calls with ctx.actions.call"
    }
  },
  "dataVersion": { "major": 1, "minor": 12 },
  "database": { "maxBytes": 1073741824 },
  "purges": ["storage"],
  "contributes": {
    "panels": [],
    "sections": [],
    "elements": [],
    "tools": [],
    "events": [
      { "id": "record_written", "title": "Record written" },
      { "id": "ruled", "title": "Operator ruled" },
      { "id": "assessed", "title": "Reviewer voted" },
      { "id": "plan_applied", "title": "Plan applied" },
      { "id": "babel_run_changed", "title": "Run changed" }
    ]
  },
