{
  "name": "babel-manifold-plugins",
  "private": true,
  "type": "module",
  "description": "Babel as a manifold plugin family: atyrode.babel (server half, the store) with atyrode.babel.feed and atyrode.babel.watch as its panels, packed as one bundle each.",
  "scripts": {
    "postinstall": "./link-externals.sh",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "pack": "./pack.sh",
    "deps:code": "bun scripts/prepare-code.ts",
    "verify": "bun \"$(./manifold-dir.sh)/packages/plugin-kit/src/verify.ts\" .integration/code/plugins/.integration/omp/plugins/dist/*.manifold-plugin.json .integration/code/plugins/dist/*.manifold-plugin.json dist/*.manifold-plugin.json",
    "dev": "./pack.sh --machine && bun \"$(./manifold-dir.sh)/packages/plugin-kit/src/dev.ts\" ."
  },
  "dependencies": {
    "@atyrode/manifold-code": "github:atyrode/code#133ec32b0bef2350fdb2a588faa99e5807e84eca",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3"
  }
}
