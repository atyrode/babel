{
  "name": "babel-manifold-plugins",
  "private": true,
  "type": "module",
  "description": "Babel's manifold plugins: atyrode.babel (baseline) and atyrode.babel.sessions, packed as isolated bundles.",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "pack": "./pack.sh",
    "verify": "bun ../../manifold/packages/plugin-kit/src/verify.ts dist/*.manifold-plugin.json",
    "dev": "bun ../../manifold/packages/plugin-kit/src/dev.ts ."
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
