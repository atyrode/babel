        "sha256": "fc0c4d8ed42a117498602731c4f94f9a2ef01ed5fd647987374430d629b7cce6",
        "format": "raw",
        "entry": [
          "machine.js"
        ],
        "entrySha256": "fc0c4d8ed42a117498602731c4f94f9a2ef01ed5fd647987374430d629b7cce6",
        "maxBytes": 4194304,
        "maxExpandedBytes": 4194304,
        "maxMembers": 1
      },
      "linux-arm64": {
        "bundleFile": "machine.js",
        "sha256": "fc0c4d8ed42a117498602731c4f94f9a2ef01ed5fd647987374430d629b7cce6",
        "format": "raw",
        "entry": [
          "machine.js"
        ],
        "entrySha256": "fc0c4d8ed42a117498602731c4f94f9a2ef01ed5fd647987374430d629b7cce6",
        "maxBytes": 4194304,
        "maxExpandedBytes": 4194304,
        "maxMembers": 1
      }
    },
    "locations": {
      "atyrode.babel.outputs": {
        "anchor": "runtime",
        "kind": "directory",
        "components": [
          "outputs"
        ],
        "revision": "2"
      },
      "atyrode.babel.cache": {
        "anchor": "state",
        "managed": true,
        "kind": "directory",
        "components": [
          "cache"
        ],
        "revision": "1",
        "guestPath": "/home/job/.cache"
      },
      "atyrode.babel.omp": {
        "anchor": "home",
        "kind": "directory",
        "components": [
          ".omp",
          "agent",
          "sessions"
        ],
        "revision": "1",
        "guestPath": "/home/job/.omp/agent/sessions"
      },
      "atyrode.babel.codex": {
        "anchor": "home",
        "kind": "directory",
        "components": [
